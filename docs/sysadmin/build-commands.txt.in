git clone ${GIT_REPO}.git --recurse-submodules
cd ReadabilityStudio

cmake -S . -B ./build -DCMAKE_BUILD_TYPE=Release
cmake --build ./build --target ${BUILD_TARGET} -j $(nproc) --config Release

