#: ui/dialogs/tools_options_dlg.cpp:5699
msgid "Selects the color for the invalid sentence/word regions."
msgstr "Selecciona el color de las regiones de oraciones/palabras no válidas."

#: ui/dialogs/tools_options_dlg.cpp:5711
msgid "Selects the layout style of the Raygor graph."
msgstr "Selecciona el estilo de diseño del gráfico de Raygor."

#: ui/dialogs/tools_options_dlg.cpp:5716
msgid "The options in this section customize the Flesch chart."
msgstr "Las opciones de esta sección personalizan el gráfico de Flesch."

#: ui/dialogs/tools_options_dlg.cpp:5726
msgid "Check this to connect the factor and score points."
msgstr "Marque esto para conectar el factor y anotar puntos."

#: ui/dialogs/tools_options_dlg.cpp:5737
msgid "Check this to display document names grouped along the syllable ruler."
msgstr ""
"Marque esta opción para mostrar los nombres de los documentos agrupados a lo "
"largo de la regla de la sílaba."

#: ui/dialogs/tools_options_dlg.cpp:5742
msgid "The options in this section customize the Lix Gauge."
msgstr "Las opciones de esta sección personalizan el calibre de Lix."

#: ui/dialogs/tools_options_dlg.cpp:5752
msgid ""
"Check this to display the English translated bracket labels on the German "
"Lix gauge."
msgstr ""
"Marque esta opción para mostrar las etiquetas de paréntesis traducidas al "
"inglés en el calibre de Lix alemán."

#: ui/dialogs/tools_options_dlg.cpp:5777 ui/dialogs/tools_options_dlg.cpp:5876
msgid "The options in this section customize the display of the bars."
msgstr ""
"Las opciones de esta sección personalizan la visualización de las barras."

#: ui/dialogs/tools_options_dlg.cpp:5786 ui/dialogs/tools_options_dlg.cpp:5884
msgid "Selects the color used for the bars."
msgstr "Selecciona el color utilizado para las barras."

#: ui/dialogs/tools_options_dlg.cpp:5791 ui/dialogs/tools_options_dlg.cpp:5889
#: ui/dialogs/tools_options_dlg.cpp:6041
msgid "Glass effect"
msgstr "Efecto vidrio"

#: ui/dialogs/tools_options_dlg.cpp:5793 ui/dialogs/tools_options_dlg.cpp:5891
