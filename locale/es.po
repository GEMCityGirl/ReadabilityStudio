msgstr "Desvanecimiento de color, de izquierda a derecha"

#: ui/dialogs/tools_options_dlg.cpp:6045
msgid "Color fade, right to left"
msgstr "Desvanecimiento de color, de derecha a izquierda"

#: ui/dialogs/tools_options_dlg.cpp:6063
msgid "Selects which effect to apply to the boxes."
msgstr "Selecciona el efecto que se va a aplicar a los cuadros."

#: ui/dialogs/tools_options_dlg.cpp:6077
msgid ""
"Sets the transparency of the box. A value of 255 will set the box to be "
"fully opaque, whereas 0 will set the box to be transparent."
msgstr ""
"Establece la transparencia de la caja. Un valor de 255 establecerá la caja "
"para que sea completamente opaco, mientras que 0 establecerá la caja para "
"que sea transparente."

#: ui/dialogs/tools_options_dlg.cpp:6083
