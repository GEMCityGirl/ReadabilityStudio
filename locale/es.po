msgstr ""
"Controlar cómo se tratan los nombres propios mediante las pruebas "
"relacionadas con Dale-Chall."

#: ui/dialogs/tools_options_dlg.cpp:4098
msgid "Exclude incomplete sentences, except headings"
msgstr "Excluir oraciones incompletas, excepto los encabezados"

#: ui/dialogs/tools_options_dlg.cpp:4099
msgid "System default**"
msgstr "Defecto de sistema**"

#: ui/dialogs/tools_options_dlg.cpp:4108
msgid "Controls how text is excluded in Dale-Chall related tests."
msgstr ""
"Controlar cómo se excluye el texto en las pruebas relacionadas con Dale-"
"Chall."

#: ui/dialogs/tools_options_dlg.cpp:4113
msgid ""
"The options in this section customize how Harris-Jacobson is calculated."
msgstr ""
"Las opciones de esta sección personalizan cómo se calcula Harris-Jacobson."

#: ui/dialogs/tools_options_dlg.cpp:4124
msgid "Controls how text is excluded in Harris-Jacobson."
msgstr "Controlar cómo se excluye el texto en Harris-Jacobson."

#: ui/dialogs/tools_options_dlg.cpp:4175
msgid ""
"The options in this section customize which results to display in the Scores "
